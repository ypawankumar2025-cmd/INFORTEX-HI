# INFORTEX HI: dedicated cloud build (does not change local Docker Compose).
# Build context MUST be the repository root (.) because frontend/, backend/,
# vendor/ and database/ are all copied from that root.
FROM ubuntu:24.04 AS cpp-build
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ cmake make libasio-dev libssl-dev libcurl4-openssl-dev \
    libsqlite3-dev libpq-dev nlohmann-json3-dev libarchive-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY backend backend
COPY vendor/Crow/include vendor/Crow/include
COPY database database
RUN cmake -S backend -B build -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j2 \
 && ctest --test-dir build --output-on-failure

FROM node:22-alpine AS web-build
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/index.html frontend/tsconfig.json frontend/vite.config.ts ./
COPY frontend/src ./src
COPY frontend/public ./public
RUN npm test && npm run build

FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    nginx gettext-base tini libssl3t64 libcurl4t64 libsqlite3-0 \
    libpq5 libarchive13t64 poppler-utils ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --uid 10001 --create-home hi
WORKDIR /app
COPY --from=cpp-build /app/build/hi_server ./hi_server
COPY database ./database
COPY --from=web-build /app/dist /usr/share/nginx/html
COPY render-nginx.conf.template ./render-nginx.conf.template
COPY render-start.sh ./render-start.sh
RUN chmod +x /app/render-start.sh \
 && mkdir -p /tmp/hi-nginx-client /tmp/hi-nginx-proxy \
 && chown -R hi:hi /app /usr/share/nginx/html /tmp/hi-nginx-client /tmp/hi-nginx-proxy
USER hi
ENV BIND_ADDRESS=127.0.0.1 SCHEMA_PATH=/app/database/schema.sql
EXPOSE 10000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["/app/render-start.sh"]
